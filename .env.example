# ==============================================================================
# AeroCrop.ai — Root / Production Docker Compose Environment Template
# Copy this file to .env before running `docker compose up` or deploying to production.
# ==============================================================================

# ─── Runtime Environment & Domain ─────────────────────────────────────────────
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# ─── JWT Authentication ───────────────────────────────────────────────────────
# CRITICAL: In production, generate a strong random 32+ character key:
# (e.g. on Linux/macOS run: `openssl rand -hex 32`)
JWT_SECRET_KEY=aerocrop-maharashtra-farm-secret-key-change-in-production-2026

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# When using Docker Compose, mongodb hostname is resolved automatically:
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=aerocrop

# ─── Outbound SMTP Email & OTP Delivery ───────────────────────────────────────
# Configure your production mail sender credentials below.
# For Gmail, generate a 16-character App Password from Google Account -> Security -> App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM=AeroCrop.ai Support <your_email@gmail.com>

# Compatibility aliases used by Docker services
FROM=your_email@gmail.com
PASS=your_16_char_google_app_password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# ─── Microservice Routing (Inside Docker) ──────────────────────────────────────
EMAIL_MICROSERVICE_BASE_URL=http://email-service:5000
EMAIL_SERVICE_URL=http://email-service:5000/send-email
EMAIL_OTP_SERVICE_URL=http://email-service:5000/send-otp

# ─── CORS Allowed Origins ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://aerocrop.devanshupatil.tech
