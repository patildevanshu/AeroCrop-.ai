# ==============================================================================
# AeroCrop.ai — Backend Environment Variables Configuration Template
# Copy this file to .env and fill in production or local credentials.
# ==============================================================================

# Server & Runtime Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security & Authentication
# CRITICAL: In production, JWT_SECRET_KEY must be a cryptographically strong random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=aerocrop-local-development-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aerocrop

# External APIs
WEATHER_API_KEY=your_openweathermap_api_key_here
MANDI_API_KEY=your_data_gov_in_api_key_here

# Direct SMTP Email Dispatch (Primary/Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM=AeroCrop.ai Support <your_email@gmail.com>

# Email Microservice Routing (Express / Node service)
# Use localhost for host development, or http://email-service:5000 inside Docker Compose
EMAIL_OTP_SERVICE_URL=http://localhost:5000/send-otp
EMAIL_SERVICE_URL=http://localhost:5000/send-email

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
